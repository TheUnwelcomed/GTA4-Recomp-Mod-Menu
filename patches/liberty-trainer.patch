+// The guest call chain above a frame: each frame's back chain at 0(r1), the
+// caller's LR saved at -8 from the caller's frame (mflr r12; stw r12,-8(r1);
+// stwu ...), read only where the guest memory is committed (the hang
+// monitor's walk, windowed_app_main_sdl.cpp).
+std::string GuestCallers(const PPCContext& ctx) {
+  std::string callers;
+  auto* thread = rex::system::XThread::GetCurrentThread();
+  auto* kernel = rex::system::kernel_state();
+  if (!thread || !kernel || !kernel->memory())
+    return callers;
+  auto* memory = kernel->memory();
+  const uint32_t lo = thread->guest_stack_limit(), hi = thread->guest_stack_base();
+  if (!lo || !hi)
+    return callers;
+  auto readable = [&](uint32_t a) {
+    uint32_t protect = 0;
+    auto* heap = memory->LookupHeap(a);
+    return heap && heap->QueryProtect(a, &protect) && (protect & rex::memory::kMemoryProtectRead);
+  };
+  uint32_t sp = ctx.r1.u32;
+  for (int i = 0; i < 12; ++i) {
+    if (sp < lo || sp + 4 > hi || (sp & 3) || !readable(sp))
+      break;
+    const uint32_t back = rex::memory::load_and_swap<uint32_t>(memory->TranslateVirtual(sp));
+    if (back <= sp || back < lo + 8 || back > hi || !readable(back - 8))
+      break;
+    callers += fmt::format(" < {:08X}", rex::memory::load_and_swap<uint32_t>(memory->TranslateVirtual(back - 8)));
+    sp = back;
+  }
+  return callers;
+}
+
+// The first words at what the argument registers point to (an object's
+// first word is its vtable, which names its class): "r3 -> 82xxxxxx ...".
+std::string GuestPointees(const PPCContext& ctx) {
+  std::string out;
+  auto* kernel = rex::system::kernel_state();
+  if (!kernel || !kernel->memory())
+    return out;
+  auto* memory = kernel->memory();
+  const std::pair<const char*, uint32_t> regs[] = {{"r3", ctx.r3.u32}, {"r4", ctx.r4.u32}, {"r5", ctx.r5.u32},
+                                                   {"r31", ctx.r31.u32}};
+  for (const auto& [name, a] : regs) {
+    uint32_t protect = 0;
+    auto* heap = memory->LookupHeap(a);
+    if (a < 0x10000 || (a & 3) || !heap || !heap->QueryProtect(a, &protect) ||
+        !(protect & rex::memory::kMemoryProtectRead) || !heap->QueryProtect(a + 12, &protect) ||
+        !(protect & rex::memory::kMemoryProtectRead))
+      continue;
+    const uint8_t* p = memory->TranslateVirtual(a);
+    out += fmt::format("; {} -> {:08X} {:08X} {:08X} {:08X}", name, rex::memory::load_and_swap<uint32_t>(p),
+                       rex::memory::load_and_swap<uint32_t>(p + 4), rex::memory::load_and_swap<uint32_t>(p + 8),
+                       rex::memory::load_and_swap<uint32_t>(p + 12));
+  }
+  return out;
+}
