+// An indirect call to no function. The game's code sets lr just before a
+// bctrl, so lr - 4 is the call and names the caller; the registers are the
+// call's arguments. A null target (an object's unfilled virtual, say) is
+// skipped as if the call returned 0 and the game goes on: v1.7.38's arrival
+// at Wake Island (log 106) ended in this trap from the render thread, the
+// game gone with it and nothing in the log of where the call came from. Any
+// other target (garbage, a jump into the middle of a function) still ends
+// the game, now with the same account of itself first.
 static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* /*base*/) {
-  REX_FATAL("Call to invalid or unregistered function at guest address 0x{:08X}",
-            ctx.last_indirect_target);
+  const uint32_t target = ctx.last_indirect_target;
+  static std::atomic<uint32_t> seen{0};
+  const uint32_t n = seen.fetch_add(1, std::memory_order_relaxed);
+  if (target != 0 || n < 16 || n % 1000 == 0) {
+    REXLOG_ERROR("Call to {} function at guest address 0x{:08X} from 0x{:08X} (lr; thread {:08X}); r1 {:08X}, r3 "
+                 "{:08X} r4 {:08X} r5 {:08X} r6 {:08X} r7 {:08X} r8 {:08X}, r29 {:08X} r30 {:08X} r31 {:08X}; "
+                 "callers{}{}; {} such call(s) so far{}",
+                 target ? "invalid or unregistered" : "a null", target, uint32_t(ctx.lr),
+                 rex::system::XThread::GetCurrentThreadHandle(), ctx.r1.u32, ctx.r3.u32, ctx.r4.u32, ctx.r5.u32,
+                 ctx.r6.u32, ctx.r7.u32, ctx.r8.u32, ctx.r29.u32, ctx.r30.u32, ctx.r31.u32, GuestCallers(ctx),
+                 GuestPointees(ctx), n + 1, target ? "" : "; skipped (as if it returned 0)");
+  }
+  if (target == 0) {
+    ctx.r3.u64 = 0;
+    return;
+  }
+  REX_FATAL("Call to invalid or unregistered function at guest address 0x{:08X} from 0x{:08X}", target,
+            uint32_t(ctx.lr));
