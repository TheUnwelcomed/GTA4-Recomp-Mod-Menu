+// The add-ons' shadow archives (gta4_addon_install.h): each guest path
+// (game:\common.rpf) redirected to its edited copy, the way the button
+// prompts redirect xbox360.rpf.
+void MountShadows(rex::Runtime* runtime, const std::vector<gta4::addons::ShadowArchive>& shadows) {
+  auto* file_system = runtime ? runtime->file_system() : nullptr;
+  if (!file_system || shadows.empty())
+    return;
+  constexpr std::string_view kMount = "\\Device\\LibertyRecomp\\AddonData";
+  auto device = std::make_unique<rex::filesystem::HostPathDevice>(
+      kMount, shadows.front().shadow.parent_path(), true);
+  if (!device->Initialize() || !file_system->RegisterDevice(std::move(device))) {
+    REXLOG_WARN("gta4-addons: could not mount {}", shadows.front().shadow.parent_path().string());
+    return;
+  }
+  for (const auto& s : shadows) {
+    std::string target(kMount);
+    target.push_back('\\');
+    target.append(s.shadow.filename().string());
+    file_system->RegisterSymbolicLink(s.guest_path, target);
+    if (s.guest_path.rfind("game:", 0) == 0)
+      file_system->RegisterSymbolicLink("d:" + s.guest_path.substr(5), target);
+    REXLOG_INFO("gta4-addons: {} now reads {}", s.guest_path, s.shadow.string());
+  }
+  gta4::addons::SetShadowsActive(true);
+}
